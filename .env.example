# === 필수 ===
ANTHROPIC_API_KEY=your-api-key-here

# === Telegram Bot ===
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id  # 에이전트 능동 알림 대상 (필수!)

# === Sun Art Center 웹사이트 API ===
# https://github.com/Raulito34/rauliton34 백엔드 (Railway 배포)
SAC_API_URL=https://your-app.railway.app
SAC_ADMIN_CODE=your-admin-code

# === 네이버 웍스 메일 (선택) ===
# 관리자가 IMAP/SMTP 허용 필요 + 외부 앱 비밀번호 생성
NAVER_WORKS_EMAIL=your-email@company.com
NAVER_WORKS_PASSWORD=your-external-app-password

# === WhatsApp Business API (선택) ===
# https://developers.facebook.com 에서 앱 생성 후 토큰/전화번호 ID 복사
WHATSAPP_TOKEN=your-meta-access-token
WHATSAPP_PHONE_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=sun-gallery-verify

# === SNS 자동 포스팅 (계정 생성 후) ===
# Instagram: Meta Developer 앱 → Graph API 토큰
INSTAGRAM_ACCESS_TOKEN=your-instagram-token
INSTAGRAM_USER_ID=your-instagram-user-id
# X (Twitter): Developer Portal → API Keys
X_API_KEY=your-x-api-key
X_API_SECRET=your-x-api-secret
X_ACCESS_TOKEN=your-x-access-token
X_ACCESS_SECRET=your-x-access-secret
