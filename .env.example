# === 필수 ===
ANTHROPIC_API_KEY=your-api-key-here

# === Telegram Bot ===
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# === 네이버 웍스 메일 (선택) ===
# 관리자가 IMAP/SMTP 허용 필요 + 외부 앱 비밀번호 생성
NAVER_WORKS_EMAIL=your-email@company.com
NAVER_WORKS_PASSWORD=your-external-app-password

# === WhatsApp Business API (선택) ===
# https://developers.facebook.com 에서 앱 생성 후 토큰/전화번호 ID 복사
WHATSAPP_TOKEN=your-meta-access-token
WHATSAPP_PHONE_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=sun-gallery-verify
